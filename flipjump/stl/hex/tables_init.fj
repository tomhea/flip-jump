// ---------- Init The Truth Tables:


ns hex {
    // Space Complexity: 6500   (6464+@)
    //                   It is 50/100KB (for w=32/64 bits)
    //                   It is 5KB in --version 3 (for both w=32/64 bits)
    // This macro initializes all truth tables for the hex-macros.
    // Use this macro exactly once, and don't use it alongside any other hex.*.init macros, as it will declare those twice.
    // @output-param ret: The return address. Jumps to it after finishing going through a table.
    // @output-param res: The result of the table calculation is written here.
    def init {
        .tables.init_all
    }

    ns tables {
        // Allocates the shared `ret` and `res` symbols used by every
        // table-driven hex operation. Called once by hex.init.
        // @output-param ret:  Shared return address for table-driven hex ops.
        // @output-param res:  Shared result hex written by table dispatch.
        def init_shared > ret, res {
          ret: ;0
          res: ..hex
        }

        // This is the inner-macro of hex.init, and it's identical to it. see hex.init documentation.
        def init_all @ end {
            ;end
          .init_shared
          ..or.init     //  595
          ..and.init    //  595
          ..mul.init    // 1620+@
          ..cmp.init    //  514
          ..add.init    // 1570
          ..sub.init    // 1570
          end:
        }

        // @Assumes: n must be a power of 2, and it must be (1<<n)-padded.
        // A table. When jumping to entry d - it xors d into dst, and jumps to ret.
        //
        //  Time Complexity: log(n) / 2     (an overage over all entries, of jumping to an entry in this table)
        // Space Complexity: n
        //
        // n is a size-constant, dst/ret are hexes.
        def clean_table_entry__table n, dst, ret @ clean {
          clean:
            rep(n, d) stl.fj \
                d==0?0: (dst+dbit+(#d)-1), \
                (d==((1<<(#d))>>1)) ? ret : clean+(d^((1<<(#d))>>1))*dw
        }

        // A table. When jumping to entry d - it xors d into dst, and jumps to hex.tables.ret
        //
        //  Time Complexity: 4
        // Space Complexity: 256
        //
        // dst is a hex.
        // @requires hex.tables.init_shared (or hex.init)
        def clean_table_entry__table dst < .ret {
            .clean_table_entry__table 256, dst, .ret
        }

        // The macro assumes that jumper_to_table is a fj-op that jumps to a 256-padded table.
        //   This macro is used as a jumper to a table that sets hex.tables.res to some (calc(dst, src) ^ dst), and jumps back.
        //
        //  Time Complexity: 4@+4
        // Space Complexity: 4@+52
        //
        // It jumps to the table, at entry (src<<4 | dst).
        // At last, it xors the value of hex.tables.res into dst.
        //
        // both dst,src are hexes, and jumper_to_table is an address.
        // @requires hex.tables.init_shared (or hex.init)
        def jump_to_table_entry dst, src, jumper_to_table @ return < .ret, .res {
            ..xor jumper_to_table  , dst
            ..xor jumper_to_table+4, src
            wflip .ret+w, return, jumper_to_table
          return:
            wflip .ret+w ,return
            ..xor_zero dst, .res
        }

        //  Time Complexity: ~n(3@+6) + @       (4@+4 for n == 1; plus the table's own time per hex)
        // Space Complexity: ~128n - 18         (112 for n == 1)
        //   Measured (w=64, through hex.or n less its table's 6 per hex; n = 1, 2, 4, 8, 16):
        //     time 48, 90, 182, 383, 757 (@~14);  space 110, 254, 510, 1022, 2046
        //   for i in range(n):
        //     jump_to_table_entry dst[i], src[i], jumper_to_table
        //
        // dst,src are hex[:n], and jumper_to_table is an address.
        // @requires hex.tables.init_shared (or hex.init)
        def jump_to_table_entries n, dst, src, jumper_to_table {
            rep(n == 1, i) .jump_to_table_entry dst, src, jumper_to_table
            rep(n >= 2, i) .chain n, dst, src, jumper_to_table
        }

        //  Time Complexity: ~n(3@+6) + @       (plus the table's own time per hex)
        // Space Complexity: ~128n - 18         (see jump_to_table_entries' measured values)
        //   for i in range(n):
        //     jump_to_table_entry dst[i], src[i], jumper_to_table
        //
        // A chain of n table jumps: .ret is set once, moved from each return label to the next with one
        //   wflip (see chained_jump), and cleared once.
        // @Assumes: n >= 2.
        // dst,src are hex[:n], and jumper_to_table is an address.
        // @requires hex.tables.init_shared (or hex.init)
        def chain n, dst, src, jumper_to_table @ return < .ret, .res {
            .chained_jump_to_table_entry dst, src, jumper_to_table, 0
            rep(n-1, i) .chain_step dst+i*dw, dst+(i+1)*dw, src+(i+1)*dw, jumper_to_table
          return:
            wflip .ret+w, return
            ..xor_zero dst+(n-1)*dw, .res
        }

        //  Time Complexity: ~2      (#(prev_return ^ return): 1-4 when chained, measured; @/2 when prev_return is 0)
        // Space Complexity: ~9      (one op, and the pad to 16)
        //   .ret = this macro's end (it was prev_return), and jump to jumper_to_table.
        //   The table returns to this macro's end, which is 16-padded: in a chain of identical steps the ends
        //   are a fixed (power of 2) stride apart, so moving .ret from one end to the next flips 1-2 bits.
        //
        // @Assumes: .ret holds prev_return (0 if it's clear). From a chain's first chained_jump until the
        //   chain clears .ret, it holds the chain's last return label - so no other .ret user (any hex table
        //   operation) may run inside the chain.
        // jumper_to_table is an address (see jump_to_table_entry); prev_return is an address, or 0.
        // @requires hex.tables.init_shared (or hex.init)
        def chained_jump jumper_to_table, prev_return @ return < .ret {
            wflip .ret+w, prev_return ^ return, jumper_to_table
            pad 16
          return:
        }

        //  Time Complexity: ~2@+2
        // Space Complexity: ~80     (two xors and chained_jump, at a 16-aligned start)
        //   The chained form of jump_to_table_entry: jumps to the table at entry (src<<4 | dst),
        //   and returns to this macro's end, with the result in .res (not yet xored into dst).
        // @Assumes: .ret holds prev_return (see chained_jump).
        //
        // both dst,src are hexes, and jumper_to_table is an address.
        // @requires hex.tables.init_shared (or hex.init)
        def chained_jump_to_table_entry dst, src, jumper_to_table, prev_return {
            ..xor jumper_to_table  , dst
            ..xor jumper_to_table+4, src
            .chained_jump jumper_to_table, prev_return
        }

        //  Time Complexity: ~3@+6      (measured: 47 at @~14.5 - hex.or n's slope less its table)
        // Space Complexity: 128       (the chain's stride, measured)
        //   prev_dst ^= .res;  .res = 0
        //   then chained_jump_to_table_entry dst, src, jumper_to_table (chained to the previous step's end).
        // @Assumes: the previous step's end is this macro's start (see chained_jump).
        //
        // prev_dst,dst,src are hexes, and jumper_to_table is an address.
        // @requires hex.tables.init_shared (or hex.init)
        def chain_step prev_dst, dst, src, jumper_to_table @ start < .res {
          start:
            ..xor_zero prev_dst, .res
            .chained_jump_to_table_entry dst, src, jumper_to_table, start
        }
    }
}
