def test_read_entry n, table, idx_n, i, expected @ idx, dst, end {
    hex.read_entry n, dst, table, idx_n, idx
    check n, dst, expected
    ;end
  idx: hex.vec idx_n, i
  dst: hex.vec n
  end:
}

def test_read_entry_byte table, idx_n, i, expected @ idx, dst, end {
    hex.read_entry_byte dst, table, idx_n, idx
    check 2, dst, expected
    ;end
  idx: hex.vec idx_n, i
  dst: hex.vec 2
  end:
}

def test_read_entry_packed nb, table, idx_n, i, expected @ idx, dst, end {
    hex.read_entry_packed nb, dst, table, idx_n, idx
    check 2*nb, dst, expected
    ;end
  idx: hex.vec idx_n, i
  dst: hex.vec 2*nb
  end:
}

// prints '=' if x[:n] == expected (mod 16^n), else '<' / '>'. Then a new line.
def check n, x, expected @ lt, eq, gt, expected_x, end {
    hex.cmp n, x, expected_x, lt, eq, gt
  lt:
    stl.output '<'
    ;end
  eq:
    stl.output '='
    ;end
  gt:
    stl.output '>'
    ;end
  expected_x: hex.vec n, expected
  end:
    stl.output '\n'
}


